'use client';

// app/admin/page.tsx
// Admin console. Data comes from /api/admin/data and every change goes through
// /api/admin/action. The server re-checks the admins table on every call, so
// this page is only the interface, not the security.

export const dynamic = 'force-dynamic';

import { useState, useEffect, useCallback, useMemo, useRef } from 'react';
import { useRouter } from 'next/navigation';
import {
  LayoutDashboard,
  Users,
  Building2,
  Package,
  AlertTriangle,
  LogOut,
  ChevronsLeft,
  ChevronsRight,
  Search,
  RefreshCw,
  X,
  Plus,
} from 'lucide-react';
import { supabase } from '../lib/supabaseClient';
import SupplierAccessModal, { type SupplierLite } from '../components/SupplierAccessModal';
import SupplierProductsModal from '../components/SupplierProductsModal';

type View = 'overview' | 'buyers' | 'suppliers' | 'orders' | 'issues';

interface Buyer {
  id: string;
  contact_name: string | null;
  company_name: string | null;
  email: string | null;
  phone: string | null;
  verification_status: string | null;
  created_at: string;
}

interface Supplier {
  id: string;
  user_id: string | null;
  company_name: string | null;
  contact_name: string | null;
  email: string | null;
  phone: string | null;
  city: string | null;
  verification_status: string | null;
  verification_level: string | null;
  rating: number | string | null;
  years_in_business: number | null;
  payment_terms: string | null;
  created_at: string;
}

interface PO {
  id: string;
  po_number: string;
  status: string | null;
  supplier_status: string | null;
  payment_status: string | null;
  total_amount: number | null;
  buyer_id: string | null;
  supplier_id: string | null;
  order_description?: string | null;
  delivery_location?: string | null;
  decline_reason?: string | null;
  created_at: string;
}

interface Dispute {
  id: string;
  po_id: string | null;
  buyer_id: string | null;
  supplier_id: string | null;
  raised_by_role: string | null;
  subject: string;
  description: string | null;
  status: string;
  resolution: string | null;
  resolved_at: string | null;
  created_at: string;
}

interface AdminData {
  buyers: Buyer[];
  suppliers: Supplier[];
  pos: PO[];
  disputes: Dispute[];
  disputesReady: boolean;
}

const ACCOUNT_BADGE: Record<string, string> = {
  verified: 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30',
  unverified: 'bg-amber-500/10 text-amber-400 border-amber-500/30',
  suspended: 'bg-red-500/10 text-red-400 border-red-500/30',
};

const ISSUE_BADGE: Record<string, string> = {
  open: 'bg-amber-500/10 text-amber-400 border-amber-500/30',
  in_review: 'bg-sky-500/10 text-sky-300 border-sky-500/30',
  resolved: 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30',
  dismissed: 'bg-slate-800 text-slate-400 border-slate-700',
};

const ISSUE_LABEL: Record<string, string> = {
  open: 'Open',
  in_review: 'In review',
  resolved: 'Resolved',
  dismissed: 'Dismissed',
};

const PO_EDGE: Record<string, string> = {
  pending: 'before:bg-amber-400',
  accepted: 'before:bg-emerald-500/60',
  declined: 'before:bg-red-500/60',
};

const PO_BADGE: Record<string, string> = {
  pending: 'bg-amber-500/10 text-amber-400 border-amber-500/30',
  accepted: 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30',
  declined: 'bg-red-500/10 text-red-400 border-red-500/30',
};

const ACCOUNT_EDGE: Record<string, string> = {
  verified: 'before:bg-emerald-500/60',
  unverified: 'before:bg-amber-400',
  suspended: 'before:bg-red-500/60',
};

const ISSUE_EDGE: Record<string, string> = {
  open: 'before:bg-amber-400',
  in_review: 'before:bg-sky-400',
  resolved: 'before:bg-emerald-500/60',
  dismissed: 'before:bg-slate-600',
};

const EDGE_BASE = 'relative overflow-hidden before:absolute before:left-0 before:top-0 before:bottom-0 before:w-1';

const PO_STATUSES = ['pending', 'confirmed', 'declined', 'cancelled'];
const LEVELS = ['basic', 'verified', 'trusted'];

const formatAmount = (n: number | null | undefined) =>
  n === null || n === undefined
    ? '—'
    : new Intl.NumberFormat('en-NG', { style: 'currency', currency: 'NGN', maximumFractionDigits: 0 }).format(n);

const formatDate = (iso?: string | null) =>
  iso ? new Date(iso).toLocaleDateString('en-NG', { day: 'numeric', month: 'short', year: 'numeric' }) : '—';

const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1).replace(/_/g, ' ');

function Skeleton({ className = '' }: { className?: string }) {
  return <div className={`rounded-md bg-slate-800 animate-pulse ${className}`} />;
}

function ListSkeleton({ rows = 3 }: { rows?: number }) {
  return (
    <div className="space-y-3">
      {Array.from({ length: rows }).map((_, i) => (
        <div key={i} className="bg-slate-900 rounded-xl border border-slate-800 p-4 animate-pulse">
          <div className="h-3.5 w-1/3 rounded bg-slate-800" />
          <div className="h-3 w-2/3 rounded bg-slate-800/70 mt-3" />
        </div>
      ))}
    </div>
  );
}

function Chips<T extends string>({
  items,
  value,
  onChange,
  className = '',
}: {
  items: { key: T; label: string; count?: number }[];
  value: T;
  onChange: (key: T) => void;
  className?: string;
}) {
  return (
    <div className={`flex gap-1 p-1 rounded-xl bg-slate-900 border border-slate-800 overflow-x-auto min-w-0 ${className}`}>
      {items.map((t) => (
        <button
          key={t.key}
          onClick={() => onChange(t.key)}
          className={`px-3.5 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap transition ${
            value === t.key ? 'bg-slate-100 text-slate-900' : 'text-slate-400 hover:text-slate-200 hover:bg-slate-800/60'
          }`}
        >
          {t.label}
          {t.count !== undefined && (
            <span className={`ml-1.5 ${value === t.key ? 'text-slate-600' : 'text-slate-500'}`}>{t.count}</span>
          )}
        </button>
      ))}
    </div>
  );
}

function SearchBox({ value, onChange, placeholder }: { value: string; onChange: (v: string) => void; placeholder: string }) {
  return (
    <div className="relative w-full lg:max-w-xs shrink-0">
      <Search className="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-500" />
      <input
        type="text"
        aria-label={placeholder}
        placeholder={placeholder}
        value={value}
        onChange={(e) => onChange(e.target.value)}
        className="w-full bg-slate-900 border border-slate-800 rounded-xl pl-10 pr-10 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500 transition"
      />
      {value && (
        <button
          onClick={() => onChange('')}
          aria-label="Clear search"
          className="absolute right-2 top-1/2 -translate-y-1/2 p-1.5 text-slate-500 hover:text-slate-200 transition"
        >
          <X className="w-4 h-4" />
        </button>
      )}
    </div>
  );
}

// One row: search on the left, segmented filter tabs on the right (stacks on small screens).
function Toolbar({ children }: { children: React.ReactNode }) {
  return <div className="flex flex-col lg:flex-row lg:items-center gap-3 mb-4">{children}</div>;
}

// One panel, four figures.
function SummaryStrip({
  items,
  loading,
}: {
  items: { label: string; value: string; tone?: string }[];
  loading: boolean;
}) {
  return (
    <section className="grid grid-cols-2 lg:grid-cols-4 rounded-xl border border-slate-800 bg-slate-900 mb-5 overflow-hidden">
      {items.map((it, i) => (
        <div
          key={it.label}
          className={`px-4 py-4 md:px-5 min-w-0 border-slate-800 ${i % 2 === 1 ? 'border-l' : ''} ${
            i > 1 ? 'border-t lg:border-t-0' : ''
          } ${i > 0 ? 'lg:border-l' : ''}`}
        >
          <p className="text-xs text-slate-400 truncate">{it.label}</p>
          {loading ? (
            <Skeleton className="h-7 w-14 mt-2" />
          ) : (
            <p className={`text-xl md:text-2xl font-bold mt-1.5 truncate ${it.tone || 'text-white'}`}>{it.value}</p>
          )}
        </div>
      ))}
    </section>
  );
}

function Empty({ title, hint }: { title: string; hint: string }) {
  return (
    <div className="bg-slate-900 rounded-xl border border-dashed border-slate-800 p-10 text-center">
      <p className="text-sm text-slate-300">{title}</p>
      <p className="text-xs text-slate-500 mt-1">{hint}</p>
    </div>
  );
}

export default function AdminDashboard() {
  const router = useRouter();
  const [ready, setReady] = useState(false);
  const [loading, setLoading] = useState(true);
  const [refreshing, setRefreshing] = useState(false);
  const [view, setView] = useState<View>('overview');
  const [collapsed, setCollapsed] = useState(false);
  const [adminEmail, setAdminEmail] = useState('');
  const [data, setData] = useState<AdminData>({ buyers: [], suppliers: [], pos: [], disputes: [], disputesReady: true });
  const [busy, setBusy] = useState<string | null>(null);

  const [search, setSearch] = useState('');
  const [accountFilter, setAccountFilter] = useState('all');
  const [poFilter, setPoFilter] = useState('all');
  const [issueFilter, setIssueFilter] = useState('open');

  const [issueOpen, setIssueOpen] = useState(false);
  const [issueForm, setIssueForm] = useState({ po_id: '', raised_by_role: 'admin', subject: '', description: '' });
  const [resolveTarget, setResolveTarget] = useState<{ dispute: Dispute; status: 'resolved' | 'dismissed' } | null>(null);
  const [resolution, setResolution] = useState('');
  const [access, setAccess] = useState<{ mode: 'create' } | { mode: 'login' | 'password'; supplier: SupplierLite } | null>(null);
  const [productsFor, setProductsFor] = useState<SupplierLite | null>(null);

  const [toast, setToast] = useState<{ text: string; tone: 'ok' | 'err' } | null>(null);
  const toastTimer = useRef<ReturnType<typeof setTimeout> | null>(null);
  const showToast = useCallback((text: string, tone: 'ok' | 'err' = 'ok') => {
    if (toastTimer.current) clearTimeout(toastTimer.current);
    setToast({ text, tone });
    toastTimer.current = setTimeout(() => setToast(null), 3500);
  }, []);

  const getToken = async () => (await supabase.auth.getSession()).data.session?.access_token || '';

  const load = useCallback(async () => {
    try {
      const res = await fetch('/api/admin/data', {
        headers: { Authorization: `Bearer ${await getToken()}` },
        cache: 'no-store',
      });
      if (res.status === 401 || res.status === 403) {
        await supabase.auth.signOut();
        router.replace('/admin/login');
        return;
      }
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const json = await res.json();
      setData({
        buyers: json.buyers || [],
        suppliers: json.suppliers || [],
        pos: json.pos || [],
        disputes: json.disputes || [],
        disputesReady: json.disputesReady !== false,
      });
    } catch (err) {
      console.error('Admin load error:', err);
      showToast('Could not load data. Try refreshing.', 'err');
    } finally {
      setLoading(false);
    }
  }, [router, showToast]);

  useEffect(() => {
    let alive = true;

    const start = async () => {
      const {
        data: { session },
      } = await supabase.auth.getSession();
      if (!session) {
        router.replace('/admin/login');
        return;
      }
      if (!alive) return;
      setAdminEmail(session.user.email || '');
      setReady(true);
      await load();
    };
    start();

    const { data: authListener } = supabase.auth.onAuthStateChange((event, session) => {
      if (event === 'SIGNED_OUT' || (!session && event !== 'INITIAL_SESSION')) {
        router.replace('/admin/login');
      }
    });

    return () => {
      alive = false;
      authListener.subscription.unsubscribe();
    };
  }, [router, load]);

  const act = async (action: string, payload: Record<string, unknown>, success: string, key: string): Promise<boolean> => {
    setBusy(key);
    try {
      const res = await fetch('/api/admin/action', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${await getToken()}` },
        body: JSON.stringify({ action, ...payload }),
      });
      const json = await res.json().catch(() => ({}));
      if (!res.ok) {
        showToast(json.error || 'That did not work. Try again.', 'err');
        return false;
      }
      showToast(success);
      await load();
      return true;
    } catch (err) {
      console.error('Admin action error:', err);
      showToast('Network error. Try again.', 'err');
      return false;
    } finally {
      setBusy(null);
    }
  };

  const handleLogout = async () => {
    await supabase.auth.signOut();
    router.replace('/admin/login');
  };

  const refresh = async () => {
    setRefreshing(true);
    await load();
    setRefreshing(false);
  };

  const goTo = (v: View) => {
    setView(v);
    setSearch('');
    setAccountFilter('all');
    setPoFilter('all');
  };

  const buyerById = useMemo(() => new Map(data.buyers.map((b) => [b.id, b])), [data.buyers]);
  const supplierById = useMemo(() => new Map(data.suppliers.map((s) => [s.id, s])), [data.suppliers]);
  const poById = useMemo(() => new Map(data.pos.map((p) => [p.id, p])), [data.pos]);
  const supplierUserIds = useMemo(
    () => new Set(data.suppliers.map((s) => s.user_id).filter(Boolean) as string[]),
    [data.suppliers]
  );

  if (!ready) {
    return (
      <div className="flex h-screen w-screen bg-slate-950 items-center justify-center">
        <div className="text-slate-400 text-sm">Loading admin console...</div>
      </div>
    );
  }

  const buyerLabel = (id?: string | null) => {
    const b = id ? buyerById.get(id) : undefined;
    return b?.contact_name || b?.company_name || b?.email || 'Unknown buyer';
  };
  const supplierLabel = (id?: string | null) => (id ? supplierById.get(id)?.company_name : null) || 'Unknown supplier';
  const statusOf = (s: string | null) => s || 'unverified';

  const q = search.trim().toLowerCase();
  const matches = (...vals: (string | null | undefined)[]) => !q || vals.some((v) => (v || '').toLowerCase().includes(q));

  const filteredBuyers = data.buyers.filter(
    (b) =>
      matches(b.contact_name, b.company_name, b.email, b.phone) &&
      (accountFilter === 'all' || statusOf(b.verification_status) === accountFilter)
  );
  const filteredSuppliers = data.suppliers.filter(
    (s) =>
      matches(s.company_name, s.contact_name, s.email, s.phone, s.city) &&
      (accountFilter === 'all' || statusOf(s.verification_status) === accountFilter)
  );
  const filteredPos = data.pos.filter(
    (p) =>
      matches(p.po_number, buyerLabel(p.buyer_id), supplierLabel(p.supplier_id)) &&
      (poFilter === 'all' || (p.supplier_status || 'pending') === poFilter)
  );
  const filteredIssues = data.disputes.filter((d) => issueFilter === 'all' || d.status === issueFilter);

  const countBy = <T,>(list: T[], pick: (x: T) => string) => (key: string) =>
    key === 'all' ? list.length : list.filter((x) => pick(x) === key).length;
  const buyerCount = countBy(data.buyers, (b) => statusOf(b.verification_status));
  const supplierCount = countBy(data.suppliers, (s) => statusOf(s.verification_status));
  const poCount = countBy(data.pos, (p) => p.supplier_status || 'pending');
  const issueCount = countBy(data.disputes, (d) => d.status);

  const accountTabs = (count: (k: string) => number) => [
    { key: 'all', label: 'All', count: count('all') },
    { key: 'unverified', label: 'Unverified', count: count('unverified') },
    { key: 'verified', label: 'Verified', count: count('verified') },
    { key: 'suspended', label: 'Suspended', count: count('suspended') },
  ];

  const activeIssues = data.disputes.filter((d) => d.status === 'open' || d.status === 'in_review');
  const unverifiedSuppliers = data.suppliers.filter((s) => statusOf(s.verification_status) === 'unverified');
  const totalValue = data.pos.reduce((t, p) => t + (p.total_amount || 0), 0);
  const recentPos = [...data.pos]
    .sort((x, y) => new Date(y.created_at).getTime() - new Date(x.created_at).getTime())
    .slice(0, 5);
  const alertTone = (n: number, tone: string) => (n > 0 ? tone : 'text-white');

  const openIssueModal = (poId = '') => {
    setIssueForm({ po_id: poId, raised_by_role: 'admin', subject: '', description: '' });
    setIssueOpen(true);
  };

  const submitIssue = async () => {
    if (!issueForm.subject.trim()) {
      showToast('Add a short subject for the issue.', 'err');
      return;
    }
    const done = await act('create_dispute', issueForm, 'Issue created', 'new-issue');
    if (done) {
      setIssueOpen(false);
      setIssueFilter('open');
      goTo('issues');
    }
  };

  const submitResolve = async () => {
    if (!resolveTarget) return;
    const { dispute, status } = resolveTarget;
    const done = await act(
      'update_dispute',
      { id: dispute.id, status, resolution },
      status === 'resolved' ? 'Issue resolved' : 'Issue dismissed',
      `issue-${dispute.id}`
    );
    if (done) {
      setResolveTarget(null);
      setResolution('');
    }
  };

  const setIssueStatus = (d: Dispute, status: string, msg: string) =>
    act('update_dispute', { id: d.id, status }, msg, `issue-${d.id}`);

  const accountActions = (kind: 'buyer' | 'supplier', id: string, status: string | null) => {
    const s = statusOf(status);
    const key = `${kind}-${id}`;
    const action = kind === 'buyer' ? 'set_buyer_status' : 'set_supplier_status';
    const noun = kind === 'buyer' ? 'Buyer' : 'Supplier';
    const btn = 'text-xs font-bold rounded-lg px-3 py-1.5 transition disabled:opacity-50';
    const set = (next: string, msg: string, confirmText?: string) => {
      if (confirmText && !window.confirm(confirmText)) return;
      act(action, { id, status: next }, msg, key);
    };
    return (
      <div className="flex gap-2 flex-wrap">
        {s === 'unverified' && (
          <button
            disabled={busy === key}
            onClick={() => set('verified', `${noun} verified`)}
            className={`${btn} bg-emerald-500 hover:bg-emerald-400 text-slate-950`}
          >
            Verify
          </button>
        )}
        {s === 'suspended' ? (
          <button
            disabled={busy === key}
            onClick={() => set('verified', `${noun} reinstated`)}
            className={`${btn} border border-slate-700 hover:border-emerald-500/50 hover:text-emerald-400 text-slate-300`}
          >
            Reinstate
          </button>
        ) : (
          <button
            disabled={busy === key}
            onClick={() =>
              set('suspended', `${noun} suspended`, `Suspend this ${kind}? They will be signed out and blocked from logging in until you reinstate them.`)
            }
            className={`${btn} border border-slate-700 hover:bg-red-500/10 hover:text-red-400 hover:border-red-500/30 text-slate-300`}
          >
            Suspend
          </button>
        )}
      </div>
    );
  };

  const inputCls =
    'w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white placeholder:text-slate-600 focus:outline-none focus:border-emerald-500';

  const navItems: { key: View; label: string; Icon: typeof Package; badge: number }[] = [
    { key: 'overview', label: 'Overview', Icon: LayoutDashboard, badge: 0 },
    { key: 'buyers', label: 'Buyers', Icon: Users, badge: 0 },
    { key: 'suppliers', label: 'Suppliers', Icon: Building2, badge: unverifiedSuppliers.length },
    { key: 'orders', label: 'Orders', Icon: Package, badge: 0 },
    { key: 'issues', label: 'Issues', Icon: AlertTriangle, badge: activeIssues.length },
  ];

  const header = (title: string, subtitle: string, action?: React.ReactNode) => (
    <header className="mb-6 flex items-start justify-between gap-4 flex-wrap">
      <div className="min-w-0">
        <h1 className="text-2xl font-bold text-white">{title}</h1>
        <p className="text-slate-400 text-sm mt-1">{subtitle}</p>
      </div>
      <div className="flex items-center gap-2 shrink-0">
        {action}
        <button
          onClick={refresh}
          disabled={refreshing}
          aria-label="Refresh data"
          className="flex items-center gap-2 border border-slate-700 hover:border-slate-500 text-slate-300 px-3 py-2 rounded-lg text-xs font-semibold transition disabled:opacity-50"
        >
          <RefreshCw className={`w-3.5 h-3.5 ${refreshing ? 'animate-spin' : ''}`} /> Refresh
        </button>
      </div>
    </header>
  );

  return (
    <div className="flex flex-col md:flex-row h-screen w-screen bg-slate-950 text-slate-100 font-sans overflow-hidden">
      {/* Sidebar: left rail on desktop, bottom tab bar on mobile */}
      <aside
        className={`order-last md:order-first shrink-0 flex md:flex-col bg-slate-900 border-t md:border-t-0 md:border-r border-slate-800 pb-[env(safe-area-inset-bottom)] md:pb-0 md:transition-[width] md:duration-200 ${
          collapsed ? 'md:w-[76px]' : 'md:w-64'
        }`}
      >
        <div className={`hidden md:flex items-center gap-3 h-16 border-b border-slate-800 shrink-0 ${collapsed ? 'justify-center' : 'px-5'}`}>
          <div className="h-9 w-9 rounded-xl bg-emerald-500 flex items-center justify-center font-bold text-slate-950 text-xl shrink-0">
            V
          </div>
          {!collapsed && (
            <div className="min-w-0">
              <p className="text-sm font-bold text-white leading-tight">Velrenta</p>
              <p className="text-[11px] text-slate-400 leading-tight">Admin console</p>
            </div>
          )}
        </div>

        <nav className="flex flex-1 md:flex-col md:gap-1 md:p-3" aria-label="Main">
          {navItems.map(({ key, label, Icon, badge }) => {
            const active = view === key;
            return (
              <button
                key={key}
                onClick={() => goTo(key)}
                title={collapsed ? label : undefined}
                aria-current={active ? 'page' : undefined}
                className={`relative flex flex-1 md:flex-none flex-col md:flex-row items-center justify-center gap-1 md:gap-3 py-2.5 md:px-3 md:rounded-lg text-[11px] md:text-sm font-medium transition ${
                  collapsed ? '' : 'md:justify-start'
                } ${
                  active
                    ? 'text-emerald-400 md:bg-emerald-500/10 md:before:absolute md:before:left-0 md:before:top-2 md:before:bottom-2 md:before:w-0.5 md:before:rounded-full md:before:bg-emerald-400'
                    : 'text-slate-400 hover:text-slate-200 md:hover:bg-slate-800/60'
                }`}
              >
                <span className="relative shrink-0">
                  <Icon className="w-5 h-5 md:w-4 md:h-4" />
                  {badge > 0 && (
                    <span
                      className={`absolute -top-1.5 -right-2.5 bg-amber-500 text-slate-950 text-[10px] font-bold rounded-full h-4 min-w-4 px-1 flex items-center justify-center ${
                        collapsed ? '' : 'md:hidden'
                      }`}
                    >
                      {badge}
                    </span>
                  )}
                </span>
                <span className={collapsed ? 'md:hidden' : ''}>{label}</span>
                {!collapsed && badge > 0 && (
                  <span className="hidden md:flex ml-auto bg-amber-500 text-slate-950 text-[10px] font-bold rounded-full h-5 min-w-5 px-1 items-center justify-center">
                    {badge}
                  </span>
                )}
              </button>
            );
          })}

          <button
            onClick={handleLogout}
            className="md:hidden flex flex-1 flex-col items-center justify-center gap-1 py-2.5 text-[11px] font-medium text-slate-400 hover:text-red-400 transition"
          >
            <LogOut className="w-5 h-5" />
            Log out
          </button>
        </nav>

        <div className="hidden md:block border-t border-slate-800 p-3 space-y-2 shrink-0">
          <button
            onClick={() => setCollapsed(!collapsed)}
            aria-label={collapsed ? 'Expand sidebar' : 'Collapse sidebar'}
            className={`w-full flex items-center gap-3 rounded-lg px-3 py-2 text-xs text-slate-500 hover:text-slate-200 hover:bg-slate-800/60 transition ${
              collapsed ? 'justify-center' : ''
            }`}
          >
            {collapsed ? (
              <ChevronsRight className="w-4 h-4" />
            ) : (
              <>
                <ChevronsLeft className="w-4 h-4" /> Collapse
              </>
            )}
          </button>

          <div className={`rounded-xl bg-slate-800/50 border border-slate-700/50 p-2.5 flex items-center gap-3 ${collapsed ? 'flex-col' : ''}`}>
            <div
              title={collapsed ? adminEmail : undefined}
              className="h-9 w-9 rounded-full bg-emerald-500/20 border border-emerald-500/30 flex items-center justify-center font-bold text-xs text-emerald-400 shrink-0"
            >
              {adminEmail[0]?.toUpperCase() || 'A'}
            </div>
            {!collapsed && (
              <div className="min-w-0 flex-1">
                <p className="text-xs font-semibold text-white truncate">{adminEmail}</p>
                <p className="text-[11px] text-emerald-400 flex items-center gap-1.5">
                  <span className="h-1.5 w-1.5 rounded-full bg-current" /> Administrator
                </p>
              </div>
            )}
            <button
              onClick={handleLogout}
              title="Log out"
              aria-label="Log out"
              className="text-slate-400 hover:text-red-400 p-1 transition shrink-0"
            >
              <LogOut className="w-4 h-4" />
            </button>
          </div>
        </div>
      </aside>

      <main className="flex-1 min-w-0 overflow-y-auto">
        <div className="max-w-6xl mx-auto p-4 md:p-8">
          {/* ───────────── Overview ───────────── */}
          {view === 'overview' && (
            <>
              {header('Overview', 'Everything happening across buyers, suppliers and orders.')}

              <section className="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-6">
                {[
                  { label: 'Buyers', value: String(data.buyers.length), sub: `${buyerCount('suspended')} suspended`, go: 'buyers' as View, Icon: Users },
                  { label: 'Suppliers', value: String(data.suppliers.length), sub: `${unverifiedSuppliers.length} awaiting verification`, go: 'suppliers' as View, Icon: Building2 },
                  { label: 'Orders', value: String(data.pos.length), sub: `${formatAmount(totalValue)} total value`, go: 'orders' as View, Icon: Package },
                  { label: 'Open issues', value: String(activeIssues.length), sub: `${issueCount('resolved')} resolved`, go: 'issues' as View, Icon: AlertTriangle },
                ].map((c) => {
                  const alert = c.label === 'Open issues' && !loading && activeIssues.length > 0;
                  return (
                    <button
                      key={c.label}
                      onClick={() => goTo(c.go)}
                      className={`text-left rounded-xl border p-4 min-w-0 hover:border-slate-600 transition ${
                        alert ? 'bg-amber-500/5 border-amber-500/30' : 'bg-slate-900 border-slate-800'
                      }`}
                    >
                      <div className="flex items-center justify-between">
                        <p className="text-xs text-slate-400">{c.label}</p>
                        <span className="h-8 w-8 rounded-lg bg-slate-800/80 border border-slate-700/60 flex items-center justify-center">
                          <c.Icon className={`w-4 h-4 ${alert ? 'text-amber-400' : 'text-emerald-400'}`} />
                        </span>
                      </div>
                      {loading ? (
                        <>
                          <Skeleton className="h-8 w-12 mt-3" />
                          <Skeleton className="h-3 w-24 mt-2" />
                        </>
                      ) : (
                        <>
                          <p className="text-3xl font-bold text-white mt-3">{c.value}</p>
                          <p className="text-xs text-slate-500 mt-1 truncate">{c.sub}</p>
                        </>
                      )}
                    </button>
                  );
                })}
              </section>

              <section className="grid lg:grid-cols-2 gap-4 mb-4">
                <div className="rounded-xl border border-slate-800 bg-slate-900 min-w-0">
                  <div className="flex items-center justify-between px-4 py-3.5 border-b border-slate-800">
                    <h2 className="text-sm font-bold text-white">Issues needing attention</h2>
                    <button onClick={() => goTo('issues')} className="text-xs font-medium text-emerald-400 hover:text-emerald-300 transition">
                      View all
                    </button>
                  </div>
                  {loading ? (
                    <div className="p-4 space-y-3">
                      <Skeleton className="h-4 w-2/3" />
                      <Skeleton className="h-4 w-1/2" />
                    </div>
                  ) : activeIssues.length === 0 ? (
                    <p className="p-6 text-xs text-slate-500 text-center">No open issues. Nothing needs your attention.</p>
                  ) : (
                    <ul className="divide-y divide-slate-800/70">
                      {activeIssues.slice(0, 5).map((d) => (
                        <li key={d.id}>
                          <button onClick={() => { setIssueFilter('all'); goTo('issues'); }} className="w-full text-left px-4 py-3 hover:bg-slate-800/40 transition">
                            <div className="flex items-center justify-between gap-3">
                              <p className="text-sm text-white truncate">{d.subject}</p>
                              <span className={`px-2 py-0.5 rounded-full text-[10px] font-semibold border shrink-0 ${ISSUE_BADGE[d.status]}`}>
                                {ISSUE_LABEL[d.status]}
                              </span>
                            </div>
                            <p className="text-xs text-slate-500 mt-0.5 truncate">
                              {d.po_id ? poById.get(d.po_id)?.po_number || 'Order' : 'No order linked'} · {formatDate(d.created_at)}
                            </p>
                          </button>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>

                <div className="rounded-xl border border-slate-800 bg-slate-900 min-w-0">
                  <div className="flex items-center justify-between px-4 py-3.5 border-b border-slate-800">
                    <h2 className="text-sm font-bold text-white">Suppliers awaiting verification</h2>
                    <button onClick={() => goTo('suppliers')} className="text-xs font-medium text-emerald-400 hover:text-emerald-300 transition">
                      View all
                    </button>
                  </div>
                  {loading ? (
                    <div className="p-4 space-y-3">
                      <Skeleton className="h-4 w-2/3" />
                      <Skeleton className="h-4 w-1/2" />
                    </div>
                  ) : unverifiedSuppliers.length === 0 ? (
                    <p className="p-6 text-xs text-slate-500 text-center">Every supplier is verified.</p>
                  ) : (
                    <ul className="divide-y divide-slate-800/70">
                      {unverifiedSuppliers.slice(0, 5).map((s) => (
                        <li key={s.id} className="flex items-center justify-between gap-3 px-4 py-3">
                          <div className="min-w-0">
                            <p className="text-sm text-white truncate">{s.company_name}</p>
                            <p className="text-xs text-slate-500 truncate">{s.email}</p>
                          </div>
                          {accountActions('supplier', s.id, s.verification_status)}
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </section>

              <section className="rounded-xl border border-slate-800 bg-slate-900 min-w-0">
                <div className="flex items-center justify-between px-4 py-3.5 border-b border-slate-800">
                  <h2 className="text-sm font-bold text-white">Recent orders</h2>
                  <button onClick={() => goTo('orders')} className="text-xs font-medium text-emerald-400 hover:text-emerald-300 transition">
                    View all
                  </button>
                </div>
                {loading ? (
                  <div className="p-4 space-y-3">
                    <Skeleton className="h-4 w-2/3" />
                    <Skeleton className="h-4 w-1/2" />
                  </div>
                ) : recentPos.length === 0 ? (
                  <p className="p-6 text-xs text-slate-500 text-center">No orders yet.</p>
                ) : (
                  <ul className="divide-y divide-slate-800/70">
                    {recentPos.map((p) => {
                      const ss = p.supplier_status || 'pending';
                      return (
                        <li key={p.id}>
                          <button onClick={() => goTo('orders')} className="w-full text-left px-4 py-3 hover:bg-slate-800/40 transition">
                            <div className="flex items-center justify-between gap-3">
                              <div className="min-w-0 flex items-center gap-2.5 flex-wrap">
                                <span className="font-mono text-sm text-white">{p.po_number}</span>
                                <span className={`px-2 py-0.5 rounded-full text-[10px] font-semibold border ${PO_BADGE[ss] || PO_BADGE.pending}`}>
                                  {cap(ss)}
                                </span>
                              </div>
                              <p className="text-sm font-semibold text-emerald-400 shrink-0">{formatAmount(p.total_amount)}</p>
                            </div>
                            <p className="text-xs text-slate-500 mt-0.5 truncate">
                              {buyerLabel(p.buyer_id)} → {supplierLabel(p.supplier_id)} · {formatDate(p.created_at)}
                            </p>
                          </button>
                        </li>
                      );
                    })}
                  </ul>
                )}
              </section>
            </>
          )}

          {/* ───────────── Buyers ───────────── */}
          {view === 'buyers' && (
            <>
              {header('Buyers', 'Verify buyers, or suspend accounts that break the rules.')}

              <SummaryStrip
                loading={loading}
                items={[
                  { label: 'Total buyers', value: String(data.buyers.length) },
                  { label: 'Verified', value: String(buyerCount('verified')), tone: 'text-emerald-400' },
                  { label: 'Unverified', value: String(buyerCount('unverified')), tone: alertTone(buyerCount('unverified'), 'text-amber-400') },
                  { label: 'Suspended', value: String(buyerCount('suspended')), tone: alertTone(buyerCount('suspended'), 'text-red-400') },
                ]}
              />

              <Toolbar>
                <SearchBox value={search} onChange={setSearch} placeholder="Search name, company, email or phone" />
                <Chips className="lg:ml-auto" items={accountTabs(buyerCount)} value={accountFilter} onChange={setAccountFilter} />
              </Toolbar>

              {loading ? (
                <ListSkeleton />
              ) : filteredBuyers.length === 0 ? (
                <Empty title="No buyers found" hint="Try a different search or filter." />
              ) : (
                <div className="space-y-3">
                  {filteredBuyers.map((b) => {
                    const s = statusOf(b.verification_status);
                    return (
                      <article
                        key={b.id}
                        className={`${EDGE_BASE} rounded-xl border border-slate-800 bg-slate-900 ${ACCOUNT_EDGE[s] || 'before:bg-slate-700'}`}
                      >
                        <div className="flex items-start gap-3 px-5 md:px-6 pt-4 md:pt-5">
                          <div className="h-10 w-10 rounded-full bg-emerald-500/15 border border-emerald-500/30 flex items-center justify-center font-bold text-sm text-emerald-400 shrink-0">
                            {(b.contact_name || b.email || 'B')[0].toUpperCase()}
                          </div>
                          <div className="min-w-0 flex-1">
                            <div className="flex items-center gap-2 flex-wrap">
                              <p className="text-sm font-semibold text-white truncate">{b.contact_name || 'Unnamed buyer'}</p>
                              <span className={`px-2.5 py-0.5 rounded-full text-[11px] font-semibold border ${ACCOUNT_BADGE[s] || ACCOUNT_BADGE.unverified}`}>
                                {cap(s)}
                              </span>
                              {supplierUserIds.has(b.id) && (
                                <span className="px-2 py-0.5 rounded-full text-[10px] font-semibold border bg-slate-800 text-slate-400 border-slate-700">
                                  Also a supplier login
                                </span>
                              )}
                            </div>
                            <p className="text-xs text-slate-400 truncate mt-0.5">{b.email || 'No email'}</p>
                          </div>
                        </div>

                        <dl className="grid grid-cols-2 sm:grid-cols-4 gap-x-6 gap-y-3 px-5 md:px-6 py-4 text-xs">
                          <div className="min-w-0"><dt className="text-[11px] text-slate-500">Phone</dt><dd className="text-slate-300 mt-0.5 truncate">{b.phone || '—'}</dd></div>
                          <div className="min-w-0"><dt className="text-[11px] text-slate-500">Company</dt><dd className="text-slate-300 mt-0.5 truncate">{b.company_name || '—'}</dd></div>
                          <div className="min-w-0"><dt className="text-[11px] text-slate-500">Orders</dt><dd className="text-slate-300 mt-0.5">{data.pos.filter((p) => p.buyer_id === b.id).length}</dd></div>
                          <div className="min-w-0"><dt className="text-[11px] text-slate-500">Joined</dt><dd className="text-slate-300 mt-0.5">{formatDate(b.created_at)}</dd></div>
                        </dl>

                        <div className="flex justify-end px-5 md:px-6 py-3 border-t border-slate-800 bg-slate-950/20">
                          {accountActions('buyer', b.id, b.verification_status)}
                        </div>
                      </article>
                    );
                  })}
                </div>
              )}
            </>
          )}

          {/* ───────────── Suppliers ───────────── */}
          {view === 'suppliers' && (
            <>
              {header(
                'Suppliers',
                'Add suppliers, give them a login, verify them, or suspend them.',
                <button
                  onClick={() => setAccess({ mode: 'create' })}
                  className="flex items-center gap-2 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold px-3.5 py-2 rounded-lg text-xs transition"
                >
                  <Plus className="w-3.5 h-3.5" /> Add supplier
                </button>
              )}

              <SummaryStrip
                loading={loading}
                items={[
                  { label: 'Total suppliers', value: String(data.suppliers.length) },
                  { label: 'Verified', value: String(supplierCount('verified')), tone: 'text-emerald-400' },
                  { label: 'Awaiting verification', value: String(supplierCount('unverified')), tone: alertTone(supplierCount('unverified'), 'text-amber-400') },
                  { label: 'Suspended', value: String(supplierCount('suspended')), tone: alertTone(supplierCount('suspended'), 'text-red-400') },
                ]}
              />

              <Toolbar>
                <SearchBox value={search} onChange={setSearch} placeholder="Search company, contact, email, phone or city" />
                <Chips className="lg:ml-auto" items={accountTabs(supplierCount)} value={accountFilter} onChange={setAccountFilter} />
              </Toolbar>

              {loading ? (
                <ListSkeleton />
              ) : filteredSuppliers.length === 0 ? (
                <Empty title="No suppliers found" hint="Try a different search or filter." />
              ) : (
                <div className="space-y-3">
                  {filteredSuppliers.map((s) => {
                    const st = statusOf(s.verification_status);
                    const level = s.verification_level || 'basic';
                    const levelKey = `level-${s.id}`;
                    return (
                      <article
                        key={s.id}
                        className={`${EDGE_BASE} rounded-xl border border-slate-800 bg-slate-900 ${ACCOUNT_EDGE[st] || 'before:bg-slate-700'}`}
                      >
                        <div className="flex items-start gap-3 px-5 md:px-6 pt-4 md:pt-5">
                          <div className="h-10 w-10 rounded-xl bg-emerald-500/15 border border-emerald-500/30 flex items-center justify-center font-bold text-sm text-emerald-400 shrink-0">
                            {(s.company_name || 'S')[0].toUpperCase()}
                          </div>
                          <div className="min-w-0 flex-1">
                            <div className="flex items-center gap-2 flex-wrap">
                              <p className="text-sm font-semibold text-white truncate">{s.company_name}</p>
                              <span className={`px-2.5 py-0.5 rounded-full text-[11px] font-semibold border ${ACCOUNT_BADGE[st] || ACCOUNT_BADGE.unverified}`}>
                                {cap(st)}
                              </span>
                              {!s.user_id && (
                                <span className="px-2 py-0.5 rounded-full text-[10px] font-semibold border bg-slate-800 text-slate-400 border-slate-700">
                                  No login
                                </span>
                              )}
                            </div>
                            <p className="text-xs text-slate-400 truncate mt-0.5">
                              {s.contact_name || '—'} · {s.email || 'No email'}
                            </p>
                          </div>
                        </div>

                        <dl className="grid grid-cols-2 sm:grid-cols-5 gap-x-6 gap-y-3 px-5 md:px-6 py-4 text-xs">
                          <div className="min-w-0"><dt className="text-[11px] text-slate-500">City</dt><dd className="text-slate-300 mt-0.5 truncate">{s.city || '—'}</dd></div>
                          <div className="min-w-0"><dt className="text-[11px] text-slate-500">Phone</dt><dd className="text-slate-300 mt-0.5 truncate">{s.phone || '—'}</dd></div>
                          <div className="min-w-0"><dt className="text-[11px] text-slate-500">Rating</dt><dd className="text-slate-300 mt-0.5">{s.rating != null && s.rating !== '' ? `★ ${Number(s.rating).toFixed(1)}` : '—'}</dd></div>
                          <div className="min-w-0"><dt className="text-[11px] text-slate-500">Orders</dt><dd className="text-slate-300 mt-0.5">{data.pos.filter((p) => p.supplier_id === s.id).length}</dd></div>
                          <div className="min-w-0"><dt className="text-[11px] text-slate-500">Terms</dt><dd className="text-slate-300 mt-0.5 truncate">{s.payment_terms || '—'}</dd></div>
                        </dl>

                        <div className="flex flex-wrap items-center justify-between gap-3 px-5 md:px-6 py-3 border-t border-slate-800 bg-slate-950/20">
                          <label className="flex items-center gap-2 text-xs text-slate-500">
                            Trust level
                            <select
                              aria-label="Trust level"
                              value={LEVELS.includes(level) ? level : 'basic'}
                              disabled={busy === levelKey}
                              onChange={(e) =>
                                act('set_supplier_level', { id: s.id, level: e.target.value }, `Level set to ${e.target.value}`, levelKey)
                              }
                              className="bg-slate-950 border border-slate-700 rounded-lg px-2.5 py-1.5 text-xs text-slate-300 capitalize focus:outline-none focus:border-emerald-500"
                            >
                              {LEVELS.map((l) => (
                                <option key={l} value={l}>{l}</option>
                              ))}
                            </select>
                          </label>

                          <div className="flex items-center gap-2 flex-wrap">
                            <button
                              onClick={() => setProductsFor(s)}
                              className="text-xs font-bold border border-slate-700 hover:border-emerald-500/50 hover:text-emerald-400 text-slate-300 rounded-lg px-3 py-1.5 transition"
                            >
                              Products &amp; prices
                            </button>
                            {s.user_id ? (
                              <button
                                onClick={() => setAccess({ mode: 'password', supplier: s })}
                                className="text-xs font-bold border border-slate-700 hover:border-slate-500 text-slate-300 rounded-lg px-3 py-1.5 transition"
                              >
                                Reset password
                              </button>
                            ) : (
                              <button
                                onClick={() => setAccess({ mode: 'login', supplier: s })}
                                className="text-xs font-bold bg-sky-500/90 hover:bg-sky-400 text-slate-950 rounded-lg px-3 py-1.5 transition"
                              >
                                Create login
                              </button>
                            )}
                            {accountActions('supplier', s.id, s.verification_status)}
                          </div>
                        </div>
                      </article>
                    );
                  })}
                </div>
              )}
            </>
          )}

          {/* ───────────── Orders ───────────── */}
          {view === 'orders' && (
            <>
              {header('Orders', 'All purchase orders. Raise an issue or override an order status when something goes wrong.')}

              <SummaryStrip
                loading={loading}
                items={[
                  { label: 'Total orders', value: String(data.pos.length) },
                  { label: 'Total value', value: formatAmount(totalValue) },
                  { label: 'Awaiting supplier', value: String(poCount('pending')), tone: alertTone(poCount('pending'), 'text-amber-400') },
                  { label: 'Accepted', value: String(poCount('accepted')), tone: 'text-emerald-400' },
                ]}
              />

              <Toolbar>
                <SearchBox value={search} onChange={setSearch} placeholder="Search PO number, buyer or supplier" />
                <Chips
                  className="lg:ml-auto"
                  items={[
                    { key: 'all', label: 'All', count: poCount('all') },
                    { key: 'pending', label: 'Awaiting supplier', count: poCount('pending') },
                    { key: 'accepted', label: 'Accepted', count: poCount('accepted') },
                    { key: 'declined', label: 'Declined', count: poCount('declined') },
                  ]}
                  value={poFilter}
                  onChange={setPoFilter}
                />
              </Toolbar>

              {loading ? (
                <ListSkeleton />
              ) : filteredPos.length === 0 ? (
                <Empty title="No orders found" hint="Try a different search or filter." />
              ) : (
                <div className="space-y-3">
                  {filteredPos.map((p) => {
                    const ss = p.supplier_status || 'pending';
                    const key = `po-${p.id}`;
                    const linked = data.disputes.filter((d) => d.po_id === p.id && (d.status === 'open' || d.status === 'in_review')).length;
                    return (
                      <article
                        key={p.id}
                        className={`${EDGE_BASE} rounded-xl border border-slate-800 bg-slate-900 ${PO_EDGE[ss] || 'before:bg-slate-700'}`}
                      >
                        <div className="flex items-start justify-between gap-4 px-5 md:px-6 pt-4 md:pt-5">
                          <div className="min-w-0 flex items-center gap-2.5 flex-wrap">
                            <span className="font-mono text-sm text-white">{p.po_number}</span>
                            <span className={`px-2.5 py-0.5 rounded-full text-[11px] font-semibold border ${PO_BADGE[ss] || PO_BADGE.pending}`}>
                              {cap(ss)}
                            </span>
                            {p.payment_status && (
                              <span className="px-2.5 py-0.5 rounded-full text-[11px] font-semibold border bg-sky-500/10 text-sky-300 border-sky-500/30">
                                {cap(p.payment_status)}
                              </span>
                            )}
                            {linked > 0 && (
                              <span className="px-2.5 py-0.5 rounded-full text-[11px] font-semibold border bg-amber-500/10 text-amber-400 border-amber-500/30">
                                {linked} open {linked === 1 ? 'issue' : 'issues'}
                              </span>
                            )}
                          </div>
                          <div className="text-right shrink-0">
                            <p className="text-xl md:text-2xl font-bold text-emerald-400 leading-none">{formatAmount(p.total_amount)}</p>
                            <p className="text-[11px] text-slate-500 mt-1">{formatDate(p.created_at)}</p>
                          </div>
                        </div>

                        <div className="px-5 md:px-6 py-4 min-w-0">
                          <p className="text-sm font-semibold text-slate-100 truncate">
                            {buyerLabel(p.buyer_id)} → {supplierLabel(p.supplier_id)}
                          </p>
                          {p.order_description && <p className="text-xs text-slate-400 mt-1">{p.order_description}</p>}
                          {ss === 'declined' && p.decline_reason && (
                            <p className="text-xs text-red-400/80 mt-2">Declined: {p.decline_reason}</p>
                          )}
                        </div>

                        <div className="flex items-center justify-between gap-3 flex-wrap px-5 md:px-6 py-3 border-t border-slate-800 bg-slate-950/20">
                          <label className="flex items-center gap-2 text-xs text-slate-500">
                            Order status
                            <select
                              value={p.status || 'pending'}
                              disabled={busy === key}
                              onChange={(e) => act('set_po_status', { id: p.id, status: e.target.value }, `${p.po_number} set to ${e.target.value}`, key)}
                              className="bg-slate-950 border border-slate-700 rounded-lg px-2.5 py-1.5 text-xs text-slate-300 capitalize focus:outline-none focus:border-emerald-500"
                            >
                              {Array.from(new Set([p.status || 'pending', ...PO_STATUSES])).map((st) => (
                                <option key={st} value={st}>{st}</option>
                              ))}
                            </select>
                          </label>
                          <button
                            onClick={() => openIssueModal(p.id)}
                            className="text-xs font-bold border border-slate-700 hover:border-amber-500/40 hover:text-amber-400 text-slate-300 rounded-lg px-3 py-1.5 transition"
                          >
                            Raise issue
                          </button>
                        </div>
                      </article>
                    );
                  })}
                </div>
              )}
            </>
          )}

          {/* ───────────── Issues ───────────── */}
          {view === 'issues' && (
            <>
              {header(
                'Issues',
                'Disputes and problems between buyers and suppliers. Review them, then resolve or dismiss.',
                <button
                  onClick={() => openIssueModal()}
                  className="flex items-center gap-2 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold px-3.5 py-2 rounded-lg text-xs transition"
                >
                  <Plus className="w-3.5 h-3.5" /> New issue
                </button>
              )}

              {!data.disputesReady && (
                <div className="mb-5 bg-amber-500/10 border border-amber-500/20 text-amber-300 text-xs rounded-xl px-4 py-3">
                  The issues table is not set up yet. Run <span className="font-mono">admin-setup.sql</span> in the Supabase SQL Editor, then refresh.
                </div>
              )}

              <SummaryStrip
                loading={loading}
                items={[
                  { label: 'Open', value: String(issueCount('open')), tone: alertTone(issueCount('open'), 'text-amber-400') },
                  { label: 'In review', value: String(issueCount('in_review')), tone: alertTone(issueCount('in_review'), 'text-sky-300') },
                  { label: 'Resolved', value: String(issueCount('resolved')), tone: 'text-emerald-400' },
                  { label: 'Dismissed', value: String(issueCount('dismissed')) },
                ]}
              />

              <Toolbar>
                <Chips
                  items={[
                    { key: 'open', label: 'Open', count: issueCount('open') },
                    { key: 'in_review', label: 'In review', count: issueCount('in_review') },
                    { key: 'resolved', label: 'Resolved', count: issueCount('resolved') },
                    { key: 'dismissed', label: 'Dismissed', count: issueCount('dismissed') },
                    { key: 'all', label: 'All', count: issueCount('all') },
                  ]}
                  value={issueFilter}
                  onChange={setIssueFilter}
                />
              </Toolbar>

              {loading ? (
                <ListSkeleton />
              ) : filteredIssues.length === 0 ? (
                <Empty
                  title={issueFilter === 'open' ? 'No open issues' : 'No issues here'}
                  hint="Use New issue, or Raise issue on an order, to log a problem."
                />
              ) : (
                <div className="space-y-3">
                  {filteredIssues.map((d) => {
                    const key = `issue-${d.id}`;
                    const po = d.po_id ? poById.get(d.po_id) : undefined;
                    const btn = 'text-xs font-bold rounded-lg px-3 py-1.5 transition disabled:opacity-50';
                    return (
                      <article
                        key={d.id}
                        className={`${EDGE_BASE} rounded-xl border border-slate-800 bg-slate-900 ${ISSUE_EDGE[d.status] || 'before:bg-slate-700'}`}
                      >
                        <div className="flex items-start justify-between gap-4 px-5 md:px-6 pt-4 md:pt-5">
                          <div className="min-w-0">
                            <p className="text-sm font-semibold text-white">{d.subject}</p>
                            <p className="text-xs text-slate-500 mt-0.5">
                              Raised by {d.raised_by_role || 'admin'} · {formatDate(d.created_at)}
                            </p>
                          </div>
                          <span className={`px-2.5 py-0.5 rounded-full text-[11px] font-semibold border shrink-0 ${ISSUE_BADGE[d.status] || ISSUE_BADGE.open}`}>
                            {ISSUE_LABEL[d.status] || d.status}
                          </span>
                        </div>

                        <div className="px-5 md:px-6 py-4">
                          {d.description && <p className="text-sm text-slate-300 whitespace-pre-wrap mb-4">{d.description}</p>}

                          <dl className="grid grid-cols-1 sm:grid-cols-3 gap-x-6 gap-y-3 text-xs">
                            <div className="min-w-0"><dt className="text-[11px] text-slate-500">Order</dt><dd className="text-slate-300 mt-0.5">{po ? `${po.po_number} · ${formatAmount(po.total_amount)}` : 'Not linked'}</dd></div>
                            <div className="min-w-0"><dt className="text-[11px] text-slate-500">Buyer</dt><dd className="text-slate-300 mt-0.5 truncate">{d.buyer_id ? buyerLabel(d.buyer_id) : '—'}</dd></div>
                            <div className="min-w-0"><dt className="text-[11px] text-slate-500">Supplier</dt><dd className="text-slate-300 mt-0.5 truncate">{d.supplier_id ? supplierLabel(d.supplier_id) : '—'}</dd></div>
                          </dl>

                          {d.resolution && (
                            <p className="mt-4 text-xs text-slate-300 bg-slate-950/60 border border-slate-800 rounded-lg px-3 py-2">
                              <span className="text-slate-500">Resolution: </span>
                              {d.resolution}
                            </p>
                          )}
                        </div>

                        <div className="flex gap-2 flex-wrap justify-end px-5 md:px-6 py-3 border-t border-slate-800 bg-slate-950/20">
                          {d.status === 'open' && (
                            <button
                              disabled={busy === key}
                              onClick={() => setIssueStatus(d, 'in_review', 'Issue moved to in review')}
                              className={`${btn} border border-slate-700 hover:border-sky-500/40 hover:text-sky-300 text-slate-300`}
                            >
                              Start review
                            </button>
                          )}
                          {(d.status === 'open' || d.status === 'in_review') && (
                            <>
                              <button
                                disabled={busy === key}
                                onClick={() => { setResolution(''); setResolveTarget({ dispute: d, status: 'dismissed' }); }}
                                className={`${btn} border border-slate-700 hover:border-slate-500 text-slate-300`}
                              >
                                Dismiss
                              </button>
                              <button
                                disabled={busy === key}
                                onClick={() => { setResolution(''); setResolveTarget({ dispute: d, status: 'resolved' }); }}
                                className={`${btn} bg-emerald-500 hover:bg-emerald-400 text-slate-950`}
                              >
                                Resolve
                              </button>
                            </>
                          )}
                          {(d.status === 'resolved' || d.status === 'dismissed') && (
                            <button
                              disabled={busy === key}
                              onClick={() => setIssueStatus(d, 'open', 'Issue reopened')}
                              className={`${btn} border border-slate-700 hover:border-amber-500/40 hover:text-amber-400 text-slate-300`}
                            >
                              Reopen
                            </button>
                          )}
                        </div>
                      </article>
                    );
                  })}
                </div>
              )}
            </>
          )}
        </div>
      </main>

      {/* New issue dialog */}
      {issueOpen && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-4" onClick={() => setIssueOpen(false)}>
          <div
            role="dialog"
            aria-modal="true"
            className="w-full max-w-md max-h-[90vh] overflow-y-auto bg-slate-900 border border-slate-700 rounded-2xl p-5"
            onClick={(e) => e.stopPropagation()}
          >
            <div className="flex items-start justify-between gap-4">
              <div>
                <h2 className="text-base font-bold text-white">New issue</h2>
                <p className="text-xs text-slate-400 mt-1">Log a problem so it can be reviewed and resolved.</p>
              </div>
              <button onClick={() => setIssueOpen(false)} aria-label="Close" className="text-slate-500 hover:text-slate-200 p-1">
                <X className="w-4 h-4" />
              </button>
            </div>

            <label htmlFor="issue-po" className="block text-xs text-slate-300 mt-4 mb-1.5">Related order (optional)</label>
            <select id="issue-po" value={issueForm.po_id} onChange={(e) => setIssueForm({ ...issueForm, po_id: e.target.value })} className={inputCls}>
              <option value="">No order</option>
              {data.pos.map((p) => (
                <option key={p.id} value={p.id}>
                  {p.po_number} · {supplierLabel(p.supplier_id)}
                </option>
              ))}
            </select>

            <label htmlFor="issue-by" className="block text-xs text-slate-300 mt-4 mb-1.5">Raised by</label>
            <select id="issue-by" value={issueForm.raised_by_role} onChange={(e) => setIssueForm({ ...issueForm, raised_by_role: e.target.value })} className={inputCls}>
              <option value="admin">Admin</option>
              <option value="buyer">Buyer</option>
              <option value="supplier">Supplier</option>
            </select>

            <label htmlFor="issue-subject" className="block text-xs text-slate-300 mt-4 mb-1.5">Subject</label>
            <input
              id="issue-subject"
              value={issueForm.subject}
              onChange={(e) => setIssueForm({ ...issueForm, subject: e.target.value })}
              placeholder="e.g. Supplier did not deliver"
              className={inputCls}
            />

            <label htmlFor="issue-desc" className="block text-xs text-slate-300 mt-4 mb-1.5">Details (optional)</label>
            <textarea
              id="issue-desc"
              rows={4}
              value={issueForm.description}
              onChange={(e) => setIssueForm({ ...issueForm, description: e.target.value })}
              placeholder="What happened?"
              className={inputCls}
            />

            <div className="flex justify-end gap-2 mt-4">
              <button onClick={() => setIssueOpen(false)} className="px-4 py-2 rounded-lg text-xs font-semibold text-slate-300 hover:bg-slate-800 transition">
                Cancel
              </button>
              <button
                onClick={submitIssue}
                disabled={busy === 'new-issue'}
                className="px-4 py-2 rounded-lg text-xs font-bold bg-emerald-500 hover:bg-emerald-400 disabled:opacity-50 text-slate-950 transition"
              >
                {busy === 'new-issue' ? 'Saving...' : 'Create issue'}
              </button>
            </div>
          </div>
        </div>
      )}

      {/* Resolve / dismiss dialog */}
      {resolveTarget && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-4" onClick={() => setResolveTarget(null)}>
          <div
            role="dialog"
            aria-modal="true"
            className="w-full max-w-md bg-slate-900 border border-slate-700 rounded-2xl p-5"
            onClick={(e) => e.stopPropagation()}
          >
            <div className="flex items-start justify-between gap-4">
              <div>
                <h2 className="text-base font-bold text-white">
                  {resolveTarget.status === 'resolved' ? 'Resolve' : 'Dismiss'} this issue?
                </h2>
                <p className="text-xs text-slate-400 mt-1">{resolveTarget.dispute.subject}</p>
              </div>
              <button onClick={() => setResolveTarget(null)} aria-label="Close" className="text-slate-500 hover:text-slate-200 p-1">
                <X className="w-4 h-4" />
              </button>
            </div>
            <label htmlFor="resolution" className="block text-xs text-slate-300 mt-4 mb-1.5">
              {resolveTarget.status === 'resolved' ? 'What was decided? (optional)' : 'Why is it being dismissed? (optional)'}
            </label>
            <textarea
              id="resolution"
              rows={3}
              value={resolution}
              onChange={(e) => setResolution(e.target.value)}
              placeholder="A short note for your records"
              className={inputCls}
            />
            <div className="flex justify-end gap-2 mt-4">
              <button onClick={() => setResolveTarget(null)} className="px-4 py-2 rounded-lg text-xs font-semibold text-slate-300 hover:bg-slate-800 transition">
                Cancel
              </button>
              <button
                onClick={submitResolve}
                disabled={busy === `issue-${resolveTarget.dispute.id}`}
                className="px-4 py-2 rounded-lg text-xs font-bold bg-emerald-500 hover:bg-emerald-400 disabled:opacity-50 text-slate-950 transition"
              >
                {resolveTarget.status === 'resolved' ? 'Mark resolved' : 'Dismiss issue'}
              </button>
            </div>
          </div>
        </div>
      )}

      {/* Add supplier / create login / reset password */}
      {access && (
        <SupplierAccessModal
          mode={access.mode}
          supplier={'supplier' in access ? access.supplier : undefined}
          act={act}
          busy={busy}
          onClose={() => setAccess(null)}
        />
      )}

      {/* Supplier products & prices */}
      {productsFor && (
        <SupplierProductsModal supplier={productsFor} act={act} busy={busy} onClose={() => setProductsFor(null)} />
      )}

      {/* Toast */}
      {toast && (
        <div
          role="status"
          className={`fixed bottom-20 md:bottom-5 left-1/2 -translate-x-1/2 z-50 px-4 py-2.5 rounded-lg text-xs font-medium border shadow-lg ${
            toast.tone === 'ok' ? 'bg-slate-900 border-emerald-500/40 text-emerald-300' : 'bg-slate-900 border-red-500/40 text-red-300'
          }`}
        >
          {toast.text}
        </div>
      )}
    </div>
  );
}